API_PORT=3333
WEB_PORT=5173
VITE_API_URL=/api

# Optional PostgreSQL/Prisma persistence. The API runs with local JSON storage
# until DATABASE_URL is provided and USE_PRISMA=true.
DATABASE_URL=postgresql://user:password@localhost:5432/tfinance
USE_PRISMA=false

# WhatsApp secretary (Baileys). Keep this container running separately so
# app updates do not force a new QR pairing.
SECRETARY_URL=http://localhost:3334
SECRETARY_TOKEN=dev-secretary-token
SECRETARY_API_URL=http://host.docker.internal:3333
SECRETARY_PORT=3334

# Google Calendar (Rotina). Create a Cloud project, enable Calendar API,
# and add http://localhost:3333/api/routine/google/callback as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/routine/google/callback
# Comma-separated list is allowed for CORS. OAuth redirects use the first origin,
# or the browser origin that started the Google/Microsoft connect flow.
WEB_ORIGIN=http://localhost:5173
ROUTINE_TOKEN_KEY=change-me-in-production

# Secretaria com IA (opcional). Sem chave, ela ainda monta o JSON localmente.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Microsoft Teams / Outlook (Azure AD app, delegated Calendars.Read + User.Read).
# Redirect: http://localhost:3333/api/routine/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3333/api/routine/microsoft/callback

# Stripe billing (monthly subscription + trial). Create the Price in the Dashboard.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_TRIAL_DAYS=7
STRIPE_SUCCESS_URL=http://localhost:5173/billing/sucesso
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancelado
BILLING_ALLOWLIST_EMAILS=
VITE_PLAN_PRICE_LABEL=R$ 29,90/mês
